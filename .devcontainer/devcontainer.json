{
  "name": "devops",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {},
  "mounts": [],
  "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/scripts/postCreateCommand.sh",
  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "vscode",
  "runArgs": [
    "--userns=keep-id:uid=1000,gid=1000"
  ],
  "containerUser": "vscode",
  "updateRemoteUserUID": false
}